# Kopieer dit bestand naar .env en vul de openbare Supabase-gegevens in
# (dezelfde Supabase als de site, geen eigen backend). Alleen de openbare
# anon key hoort hier in — nooit een service-key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optioneel: alleen invullen om lokaal tegen `npm run dev` in de hoofdmap te
# testen in plaats van tegen de live site, bijvoorbeeld
# http://localhost:3000. Leeg laten gebruikt https://afgeleideoefenen.nl.
EXPO_PUBLIC_API_BASE_URL=
