{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afgeleide-oefenen",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // /nl geeft het klaargezette bestand, zonder eerst door te sturen naar /nl/.
    "html_handling": "drop-trailing-slash",
    // Cloudflare geeft een bestand dat op het pad past altijd rechtstreeks
    // terug, los van een zoekopdracht of koekje (AFG-632). Voor /nl, /theorie,
    // /uitleg-videos en /voorbeeld/* kan dat: die hebben geen zoekopdracht die
    // iets anders moet laten zien. /inloggen wel (`?naar=`, `?error=`,
    // `?mail=`, of een sessiekoekje): die moeten naar de gewone server in
    // plaats van altijd het klaargezette, anonieme bestand te krijgen. Dit
    // stuurt alleen dat ene pad eerst naar de worker, die zelf beslist
    // (zie src/lib/startpagina-snel.ts, anoniemeInloggenPagina).
    "run_worker_first": ["/nl/inloggen", "/nl/inloggen/"]
  },
  // De startpagina-ingang blijft klein. worker-next.js is de al gebundelde
  // Next-server en laadt pas als een pagina hem echt nodig heeft.
  "find_additional_modules": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/worker-next.js"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  },
  // Elke dag om 16:00 UTC (18:00 Nederlandse zomertijd, 17:00 wintertijd):
  // de herinneringsmail voor wie een tijdje niet geoefend heeft (AFG-487).
  // Dit is de eerste geplande taak van de site. De scheduled-ingang staat in
  // scripts/statische-cache.mjs en roept /api/cron/herinneringen aan.
  "triggers": {
    "crons": ["0 16 * * *"]
  }
  // Geheimen staan als Worker-secrets in Cloudflare, nooit in dit bestand.
  // De volledige lijst (naam, bouw of runtime, geheim of niet) staat in
  // scripts/worker-omgeving.json en docs/omgeving.md.
  // NEXT_PUBLIC_*-waarden worden tijdens de build ingebakken: die staan bij
  // de build-variabelen van Workers Builds.
}
