{
  "name": "afgeleideoefenen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:oefenstof": "vitest run src/lib/practice/oefenstof.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "cf:build": "opennextjs-cloudflare build && node scripts/statische-cache.mjs",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:build:wiskundemetaaf": "NEXT_PUBLIC_SITE_VARIANT=wiskundemetaaf opennextjs-cloudflare build -c wrangler.wiskundemetaaf.jsonc && node scripts/statische-cache.mjs",
    "cf:preview:wiskundemetaaf": "NEXT_PUBLIC_SITE_VARIANT=wiskundemetaaf opennextjs-cloudflare build -c wrangler.wiskundemetaaf.jsonc && NEXT_PUBLIC_SITE_VARIANT=wiskundemetaaf opennextjs-cloudflare preview -c wrangler.wiskundemetaaf.jsonc",
    "dev:wiskundemetaaf": "NEXT_PUBLIC_SITE_VARIANT=wiskundemetaaf next dev",
    "postinstall": "node scripts/koppel-bouw.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "katex": "^0.18.2",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "@dotenvx/dotenvx": {
      "undici": "^6.29.1"
    },
    "glob": "^13.0.6"
  },
  "packageManager": "npm@11.21.1"
}
