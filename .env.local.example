# =====================================================================
# Template voor .env.local — kopieer naar .env.local en vul in.
# Deploy deze keys NOOIT in versioning. .env.local staat in .gitignore.
# =====================================================================

# ---- Supabase ------------------------------------------------------
# Publieke waarden, mogen in de browser terechtkomen:
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<jouw supabase anon key>

# Service role — alleen server-side gebruiken, NOOIT exposen:
SUPABASE_SERVICE_ROLE_KEY=<jouw supabase service role key>

# ---- Google Gemini -------------------------------------------------
# Alleen server-side. Vraag een key aan op https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<jouw gemini api key>

# ---- Publieke site-URL (voor metadata, sitemap, robots) ------------
# Laat dit in productie wijzen naar het adres waar de site echt staat — dus
# mét www, want afgeleideoefenen.nl stuurt daarnaartoe door:
# NEXT_PUBLIC_SITE_URL=https://www.afgeleideoefenen.nl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Welke van de twee sites je bouwt ------------------------------
# Er staan twee sites in deze repo: afgeleideoefenen.nl (afgeleide) en
# wiskundemetaaf.nl (wiskundemetaaf). Zelfde code, zelfde database, zelfde
# accounts; alleen de naam, de startpagina en de teksten verschillen.
# Zonder deze regel is het afgeleide. Lokaal kijken naar de andere site:
# npm run dev:wiskundemetaaf
# NEXT_PUBLIC_SITE_VARIANT=wiskundemetaaf

# ---- Bezoekersteller (Cloudflare Web Analytics) --------------------
# Publiek token. Leeg of weggelaten: er wordt geen tellerscript geladen,
# dus lokaal en in de tests gebeurt er niets. Live zet Aaf dit in de
# bouwvariabelen van Workers Builds, niet in dit bestand. Omdat de naam
# met NEXT_PUBLIC_ begint, wordt de waarde bij de bouw ingebakken.
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# ---- Aanmelden met Google ------------------------------------------
# Zet op 1 als Google in Supabase aan staat. Zonder deze regel (of een
# andere waarde) is de knop "Doorgaan met Google" nergens te zien.
# Live hoort dit bij de bouwvariabelen van Workers Builds: de naam begint
# met NEXT_PUBLIC_ en wordt bij de bouw ingebakken. Daarna is een nieuwe
# bouw nodig, anders blijft de knop weg.
# NEXT_PUBLIC_GOOGLE_LOGIN=1

# ---- Resend (de mail die de site zelf stuurt) ----------------------
# Nodig voor de welkomstmail, het seintje "nieuwe gebruiker", het
# feedbackformulier en het video-verzoek. Zonder key gaat die mail er stil
# niet uit — je ziet alleen een regel in de serverlog.
# Key aanvragen op https://resend.com/api-keys
#
# LET OP: de mail van het inloggen (bevestig je e-mailadres, wachtwoord
# vergeten) gaat NIET hierlangs. Die verstuurt Supabase zelf, en wie dat
# doet stel je in onder Supabase → Authentication → Emails → SMTP Settings.
# Staat "Enable Custom SMTP" daar uit, dan gebruikt Supabase zijn eigen
# testmailer en komen er maar een paar mails per uur doorheen.
# Zie het kopje "Mail gaat langs twee wegen" in README.md.
RESEND_API_KEY=re_<jouw resend api key>

# Afzender van de mail die de site zelf stuurt. Moet een adres zijn op een
# domein dat je bij Resend geverifieerd hebt, anders weigert Resend de mail.
# Zonder deze regel valt de code terug op no-reply@afgeleideoefenen.nl
EMAIL_FROM=no-reply@afgeleideoefenen.nl

# Adres waar alle post van de site heen gaat: het seintje "nieuwe gebruiker",
# feedback, een vraag via Aaf en een video-verzoek. Geen standaardwaarde: laat
# je hem leeg, dan gaan die berichten niet weg.
NOTIFY_EMAIL=<jouw eigen e-mailadres>

# ---- Supabase webhooks ---------------------------------------------
# Zelfbedacht geheim. Dezelfde waarde hoort in de Vault als `webhook_secret`
# (lokaal doet seed.sql dat). De triggers lezen hem daar; zet hem niet in een
# webhook in het Supabase-dashboard, want dan staat hij leesbaar in de
# database. Komt hij niet overeen, dan antwoorden /api/webhooks/welkom en
# /api/webhooks/new-user met 401 en gaat er geen welkomstmail of seintje uit.
WEBHOOK_SECRET=<zelf een lange willekeurige string verzinnen>


# ---- Klikmeting ----------------------------------------------------
# De eigen klikmeting (/api/meet) staat lokaal uit, zodat je eigen klikken
# niet in de cijfers komen. Zet hem op 1 als je hem op je eigen computer wilt
# bekijken. Op de echte site hoeft deze regel er niet te staan.
# NEXT_PUBLIC_MEET_LOKAAL=1

# Geheim waarmee de klikmeting de schuilnaam van een ingelogde leerling
# uitrekent: HMAC-SHA256(user_id, dit geheim), 16 tekens. Dezelfde waarde
# hoort in de Vault als `meet_schuilnaam_geheim` (lokaal doet seed.sql dat),
# anders rekenen de site en de overzichten van de analist verschillend.
# Zonder deze regel blijft de schuilnaam gewoon leeg.
MEET_SCHUILNAAM_GEHEIM=lokaal-nep-schuilnaamgeheim
