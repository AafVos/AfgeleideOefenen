# =====================================================================
# Template voor .env.local — kopieer naar .env.local en vul in.
# Deploy deze keys NOOIT in versioning. .env.local staat in .gitignore.
# =====================================================================

# ---- Supabase ------------------------------------------------------
# Publieke waarden, mogen in de browser terechtkomen:
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<jouw supabase anon key>

# Service role — alleen server-side gebruiken, NOOIT exposen:
SUPABASE_SERVICE_ROLE_KEY=<jouw supabase service role key>

# ---- Google Gemini -------------------------------------------------
# Alleen server-side. Vraag een key aan op https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<jouw gemini api key>

# ---- Publieke site-URL (voor metadata, sitemap, robots) ------------
# Laat dit in productie wijzen naar je echte domein, bv:
# NEXT_PUBLIC_SITE_URL=https://afgeleideoefenen.nl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- PostHog Analytics ---------------------------------------------
# Maak een gratis account op https://posthog.com en kopieer je project API key.
# Host is standaard EU (eu.i.posthog.com). Voor US: us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_<jouw project api key>
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Resend (de mail die de site zelf stuurt) ----------------------
# Nodig voor de welkomstmail, het seintje "nieuwe gebruiker", het
# feedbackformulier en het video-verzoek. Zonder key gaat die mail er stil
# niet uit — je ziet alleen een regel in de serverlog.
# Key aanvragen op https://resend.com/api-keys
#
# LET OP: de mail van het inloggen (bevestig je e-mailadres, wachtwoord
# vergeten) gaat NIET hierlangs. Die verstuurt Supabase zelf, en wie dat
# doet stel je in onder Supabase → Authentication → Emails → SMTP Settings.
# Staat "Enable Custom SMTP" daar uit, dan gebruikt Supabase zijn eigen
# testmailer en komen er maar een paar mails per uur doorheen.
# Zie het kopje "Mail gaat langs twee wegen" in README.md.
RESEND_API_KEY=re_<jouw resend api key>

# Afzender van de mail die de site zelf stuurt. Moet een adres zijn op een
# domein dat je bij Resend geverifieerd hebt, anders weigert Resend de mail.
# Zonder deze regel valt de code terug op no-reply@afgeleideoefenen.nl
EMAIL_FROM=no-reply@afgeleideoefenen.nl

# Adres waar het seintje "nieuwe gebruiker" heen gaat. Geen standaardwaarde:
# laat je hem leeg, dan mislukt die mail.
NOTIFY_EMAIL=<jouw eigen e-mailadres>

# ---- Supabase webhooks ---------------------------------------------
# Zelfbedacht geheim, moet gelijk zijn aan de header `x-webhook-secret` die je
# in Supabase → Database → Webhooks instelt voor /api/webhooks/welkom en
# /api/webhooks/new-user. Komt hij niet overeen, dan antwoorden beide
# webhooks met 401 en gaat er geen welkomstmail of seintje uit.
WEBHOOK_SECRET=<zelf een lange willekeurige string verzinnen>

# ---- Welke site draai je? ------------------------------------------
# Dezelfde code bedient afgeleideoefenen.nl en integraaloefenen.nl.
# Kies 'afgeleiden' of 'integralen'. Leeg laten = 'afgeleiden'.
NEXT_PUBLIC_SITE=afgeleiden
